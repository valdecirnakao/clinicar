# Acrescente estas linhas ao .env EXISTENTE na pasta C:\TG.
# Não substitua as chaves MYSQL_* e MFA_ENCRYPTION_KEY já usadas pelo projeto.
# A senha de app é criada na Conta do Google; deixe-a fora de ZIPs e conversas.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=mecanicageralclinicar@gmail.com
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_STARTTLS_REQUIRED=true
MAIL_FROM=mecanicageralclinicar@gmail.com

# Comece com o agendador pausado para evitar envios reais durante a troca.
CLINICAR_MANUTENCAO_AGENDADOR_HABILITADO=false
