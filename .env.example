# ============================================================
# CliniCar - configuracao opcional
# ============================================================
#
# O projeto funciona localmente sem este arquivo.
# O Docker Compose possui fallbacks destinados exclusivamente
# ao ambiente academico/local.
#
# Para utilizar valores proprios, copie este arquivo para .env
# e preencha os campos desejados.
#
# Nunca versione o arquivo .env real.

MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=

# Base64 de exatamente 32 bytes.
MFA_ENCRYPTION_KEY=

# WhatsApp permanece desativado por padrao.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=