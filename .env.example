# EXEMPLO SEM SENHAS. Em instalacao existente, preserve seu .env atual.
# Alterar estas senhas NAO redefine as contas de um volume MySQL existente.
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
# Preserve a chave MFA existente para nao perder o acesso ao 2FA.
MFA_ENCRYPTION_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=mecanicageralclinicar@gmail.com
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_STARTTLS_REQUIRED=true
MAIL_FROM=mecanicageralclinicar@gmail.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
CLINICAR_WHATSAPP_ENABLED=false
# Configuracao tecnica do servidor; nao editavel pela tela de alertas.
CLINICAR_ESTOQUE_ALERTA_TEMPLATE=alerta_estoque_peca
CLINICAR_ESTOQUE_ALERTA_IDIOMA=pt_BR
# Apos a aprovacao do template na Meta, habilite os dois parametros abaixo no .env.
# O envio tambem depende da opcao Ativo e das regras configuradas na tela Alertas.
CLINICAR_MANUTENCAO_AGENDADOR_HABILITADO=false
CLINICAR_MANUTENCAO_WHATSAPP_HABILITADO=false
WHATSAPP_TEMPLATE_ALERTA_MANUTENCAO=alerta_manutencao_preventiva
